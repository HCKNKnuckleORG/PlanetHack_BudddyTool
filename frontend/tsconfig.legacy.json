{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "../python/web/static/js",
    "rootDir": "legacy",
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": ["legacy/**/*.ts"]
}
